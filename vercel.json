{
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data/**,evidence/**,comparator/**,mcp/**,packages/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/video.mp4",
      "destination": "/praman-desk-walkthrough.mp4"
    },
    {
      "source": "/demo.mp4",
      "destination": "/praman-desk-walkthrough.mp4"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/desks",
      "destination": "/desks/index.html"
    },
    {
      "source": "/verify",
      "destination": "/verify/index.html"
    },
    {
      "source": "/case/:id",
      "destination": "/verify/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/:slug",
      "destination": "/docs/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
